{
  "name": "bobbie-digital-hub-server",
  "version": "1.0.0",
  "description": "Local-first backend server and event bus for Bobbie Digital Hub",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "agent:coder": "tsx src/agents/coderAgent.ts",
    "agent:coder:sandboxed": "tsx src/agents/sandboxedCoderAgent.ts",
    "agent:security:sandboxed": "tsx src/agents/sandboxedSecurityAgent.ts",
    "agent:tester:sandboxed": "tsx src/agents/sandboxedTesterAgent.ts",
    "agent:script:sandboxed": "tsx src/agents/sandboxedScriptAgent.ts",
    "agent:ops:sandboxed": "tsx src/agents/sandboxedStudioOpsAgent.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.7.1",
    "@google/genai": "^2.17.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/fs-extra": "^11.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "fs-extra": "^11.4.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "drizzle-kit": "^0.21.4",
    "supertest": "^7.2.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  }
}
